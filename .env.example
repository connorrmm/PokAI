# PokAI environment variables.
#
# Copy to .env.local and fill in. .env.local is gitignored; keep it that way.
# THIS REPOSITORY IS PUBLIC — never commit a real value into this file.
#
# In production these live in Vercel → Settings → Environment Variables.
# Anything named NEXT_PUBLIC_ is baked into the browser bundle AT BUILD TIME,
# so changing one requires a redeploy, not just a restart.

# ---------------------------------------------------------------------------
# Required — the app cannot scan without these
# ---------------------------------------------------------------------------

# tcgapi.dev. Card catalogue and prices. Server-side only.
# Without it /api/search fails and the scanner has no card database.
TCGAPI_KEY=

# Anthropic. The vision model that recognises the card.
# Without it scanning falls back to on-device OCR, which reads real photos badly.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — accounts and saved collections
# ---------------------------------------------------------------------------

# Live project: yycsgtsvkhguzihyxtur (us-east-2, Postgres 17)
NEXT_PUBLIC_SUPABASE_URL=https://yycsgtsvkhguzihyxtur.supabase.co

# The publishable key. PUBLIC BY DESIGN — it is safe in client code, and
# row-level security is what actually protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role / secret key. BYPASSES ROW-LEVEL SECURITY ENTIRELY.
#
# Used for exactly one thing: reading the card catalogue, which migration 0004
# made server-only for licence compliance. It must never appear in client code,
# in a commit, or in a chat window. If you only want to run the app locally,
# leave it blank — the app works without it, it just re-fetches prices from
# tcgapi.dev instead of using the cache.
#
# Newer Supabase projects issue this as sb_secret_... under the name
# SUPABASE_SECRET_KEY. Either name works.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Cloudflare Turnstile. Stops a script mass-creating anonymous accounts to burn
# the scanning budget. The captcha code is inert until this is set.
# The matching SECRET goes into Supabase (Auth → Settings), never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Override the vision model. Defaults to claude-haiku-4-5.
POKAI_VISION_MODEL=
